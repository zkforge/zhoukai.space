---
import type { MarkdownHeading } from "astro";

export interface Props {
  headings: MarkdownHeading[];
}

const headings = Astro.props.headings.filter(
  heading =>
    heading.depth >= 2 && heading.depth <= 3 && heading.text.trim() !== "目录"
);
---

{
  headings.length > 0 && (
    <aside
      data-pagefind-ignore
      class="fixed top-1/2 right-[max(1rem,calc((100vw-56rem)/2-14rem))] hidden w-52 -translate-y-1/2 min-[86rem]:block"
    >
      <nav
        aria-label="文章目录"
        class="toc-scroll max-h-[60vh] overflow-y-auto border-l border-border pl-4 text-xs leading-5"
      >
        <div class="mb-3 font-semibold text-foreground">本页目录</div>
        <ol class="space-y-2">
          {headings.map((heading, index) => (
            <li class:list={[heading.depth === 3 && "pl-4"]}>
              <a
                data-toc-link
                href={`#${heading.slug}`}
                aria-current={index === 0 ? "location" : undefined}
                class="toc-link block break-words border-l-2 border-transparent pl-2 opacity-70 transition hover:text-accent hover:opacity-100"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </aside>
  )
}

<script is:inline data-astro-rerun>
  function updateActiveTocItem() {
    window.__activeTocController?.abort();

    const links = Array.from(document.querySelectorAll("[data-toc-link]"));
    if (links.length === 0) return;

    const controller = new AbortController();
    window.__activeTocController = controller;

    const items = links
      .map(link => {
        const id = decodeURIComponent(link.hash.slice(1));
        const heading = document.getElementById(id);
        return heading ? { link, heading } : null;
      })
      .filter(Boolean);

    if (items.length === 0) return;

    function setActiveLink(activeLink) {
      for (const link of links) {
        if (link === activeLink) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    }

    function refreshActiveLink() {
      const readingLine = window.innerHeight * 0.3;
      const current =
        items
          .filter(
            ({ heading }) => heading.getBoundingClientRect().top <= readingLine
          )
          .at(-1) ?? items[0];

      setActiveLink(current.link);
    }

    refreshActiveLink();
    document.addEventListener("scroll", refreshActiveLink, {
      passive: true,
      signal: controller.signal,
    });
    window.addEventListener("resize", refreshActiveLink, {
      signal: controller.signal,
    });
  }

  updateActiveTocItem();
</script>

<style>
  .toc-scroll {
    scrollbar-width: none;
  }

  .toc-scroll::-webkit-scrollbar {
    display: none;
  }

  .toc-link[aria-current="location"] {
    border-color: var(--accent);
    color: var(--accent);
    opacity: 1;
  }
</style>
