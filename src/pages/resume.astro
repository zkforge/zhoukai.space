---
// Note: This file is excluded from TypeScript checking in tsconfig.json
// due to Astro template parsing limitations. Be careful when modifying!
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/config";

// SEO 配置
const title = `Resume | ${SITE.title}`;
const description = "Kai Zhou's Resume - 个人简历";
---

<Layout title={title} description={description}>
  <Header />
  <Main pageTitle="Resume" pageDesc="A PDF preview of my resume.">
    <!-- PDF 容器 -->
    <div class="resume-preview pdf-wrapper">
      <!-- 加载动画 -->
      <div class="loading-spinner" id="loading-spinner">
        <div class="spinner"></div>
        <p>加载简历中...</p>
      </div>

      <!-- 桌面端：iframe 嵌入 -->
      <div class="pdf-viewer-desktop">
        <iframe
          id="pdf-iframe"
          data-pdf-src="/resume.pdf#view=fitH"
          class="pdf-iframe"
          title="Kai Zhou's Resume"
        />
        <div class="pdf-fallback" id="pdf-fallback" hidden>
          <p class="fallback-text" id="pdf-fallback-text">
            无法预览 PDF 简历
          </p>
          <a id="pdf-download-button" href="/resume.pdf" download class="download-button">
            下载 PDF 简历
          </a>
        </div>
      </div>
    </div>
  </Main>
  <Footer />
</Layout>

<style>
  /* PDF 包装器 */
  .pdf-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 210 / 297;
    min-height: 80vh;
    max-height: 90vh;
  }

  /* 加载动画 */
  .loading-spinner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--background);
    z-index: 10;
  }

  .spinner {
    width: 3rem;
    height: 3rem;
    border-width: 4px;
    border-style: solid;
    border-radius: 9999px;
    border-color: var(--muted);
    border-top-color: var(--accent);
    animation: spin 1s linear infinite;
  }

  .loading-spinner p {
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--foreground);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* 桌面端 PDF 查看器 */
  .pdf-viewer-desktop {
    width: 100%;
    height: 100%;
    border-radius: 0.5rem;
    overflow: hidden;
    box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    border: 1px solid var(--border);
  }

  .pdf-iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* 降级方案 */
  .pdf-fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 2rem;
    text-align: center;
    background: var(--background);
  }

  .fallback-text {
    font-size: 1rem;
    margin-bottom: 1rem;
    color: var(--foreground);
  }

  .download-button {
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    border-radius: 0.5rem;
    font-weight: 500;
    text-align: center;
    transition: all 0.2s;
    background: var(--accent);
    color: var(--background);
  }

  .download-button:hover {
    opacity: 0.9;
  }

  /* 响应式设计 */
  @media (max-width: 767px) {
    .pdf-wrapper {
      aspect-ratio: auto;
      height: auto;
    }
  }

  /* 竖屏模式：明确设置 height */
  @media (max-width: 767px) and (orientation: portrait) {
    .pdf-wrapper {
      height: 90dvh;  /* 明确设置高度，覆盖 height: auto */
      max-height: 95dvh;
    }
  }

  /* 打印样式 */
  @media print {
    :global(header),
    :global(footer),
    :global(nav[aria-label="breadcrumb"]),
    :global(#main-content > h1),
    :global(#main-content > p) {
      display: none !important;
    }

    .pdf-wrapper {
      max-width: none;
      aspect-ratio: auto;
      max-height: none;
    }

    .pdf-iframe {
      height: auto;
      min-height: 100vh;
    }

    .loading-spinner {
      display: none !important;
    }
  }
</style>

<script>
  const spinner = document.getElementById("loading-spinner");
  const iframe = document.getElementById("pdf-iframe");
  const fallback = document.getElementById("pdf-fallback");
  const fallbackText = document.getElementById("pdf-fallback-text");
  const downloadButton = document.getElementById("pdf-download-button");
  const preview = document.querySelector(".resume-preview");

  const hideSpinner = () => {
    if (spinner) spinner.style.display = "none";
  };

  const showFallback = (reason = "unsupported") => {
    if (fallbackText) {
      fallbackText.textContent =
        reason === "missing"
          ? "未找到简历文件，暂时无法提供预览或下载。"
          : "您的浏览器不支持 PDF 内嵌查看";
    }
    if (downloadButton) {
      downloadButton.hidden = reason === "missing";
    }
    if (fallback) fallback.hidden = false;
    if (iframe) iframe.hidden = true;
    preview?.setAttribute("data-pdf-loaded", "false");
    hideSpinner();
  };

  const verifyPdfResource = async () => {
    try {
      const response = await fetch("/resume.pdf", {
        method: "HEAD",
        cache: "no-store",
      });
      const contentType = response.headers.get("content-type")?.toLowerCase() ?? "";
      if (response.status === 404) return "missing";
      if (!response.ok) return "unavailable";
      return contentType.includes("pdf") ? "ok" : "unavailable";
    } catch {
      return "unavailable";
    }
  };

  const initResumePreview = async () => {
    if (!(iframe instanceof HTMLIFrameElement)) {
      showFallback();
      return;
    }

    const pdfState = await verifyPdfResource();
    if (pdfState !== "ok") {
      showFallback(pdfState);
      return;
    }

    iframe.addEventListener("load", () => {
      preview?.setAttribute("data-pdf-loaded", "true");
      hideSpinner();
    });
    iframe.addEventListener("error", () => showFallback("unsupported"));

    iframe.src = iframe.dataset.pdfSrc ?? "/resume.pdf#view=fitH";

    setTimeout(() => {
      const hasLoaded = preview?.getAttribute("data-pdf-loaded") === "true";
      if (!hasLoaded) showFallback("unsupported");
    }, 3000);
  };

  initResumePreview();
</script>
