---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";

const email = "kaizhou0305@gmail.com";
const title = `Contact | ${SITE.title}`;
const description = `Contact ${SITE.author} via WeChat or email.`;
---

<Layout title={title} description={description}>
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-app flex-1 px-4 py-10">
    <div class="space-y-10">
      <header class="space-y-3 border-b border-border pb-6">
        <h1 class="text-3xl font-bold text-accent sm:text-4xl">Contact</h1>
        <p class="max-w-2xl text-sm leading-7 opacity-80 sm:text-base">
          如果你想交流博客文章、研究项目或开源协作，可以通过微信或邮件联系我。
        </p>
      </header>

      <section
        id="wechat"
        class="grid gap-6 rounded-lg border border-border bg-muted/20 p-5 sm:grid-cols-[minmax(0,1fr)_18rem] sm:items-center sm:p-6"
        aria-labelledby="wechat-title"
      >
        <div class="space-y-4">
          <div class="space-y-2">
            <h2 id="wechat-title" class="text-2xl font-bold text-accent">
              WeChat
            </h2>
            <p class="text-sm leading-7 opacity-80 sm:text-base">
              扫描右侧二维码添加微信。
            </p>
          </div>

          <dl class="space-y-2 text-sm leading-7 sm:text-base">
            <div>
              <dt class="inline font-semibold">微信号：</dt>
              <dd class="inline opacity-80">zk471104594</dd>
            </div>
          </dl>
        </div>

        <div class="flex justify-center sm:justify-end">
          <img
            src="/wechat-qr.png"
            alt={`Add ${SITE.author} on WeChat QR code`}
            class="aspect-square w-full max-w-64 rounded-lg border border-border bg-background object-contain p-3 shadow-sm"
            width="512"
            height="512"
            loading="eager"
          />
        </div>
      </section>

      <section
        class="rounded-lg border border-border p-5 sm:p-6"
        aria-labelledby="email-title"
      >
        <div class="space-y-3">
          <h2 id="email-title" class="text-2xl font-bold text-accent">Email</h2>
          <p class="text-sm leading-7 opacity-80 sm:text-base">
            如果需要发送较完整的背景信息或文件，邮件通常更适合。
          </p>
          <LinkButton
            href={`mailto:${email}`}
            class="inline-flex items-center font-semibold underline decoration-dashed underline-offset-4"
            title={`Send an email to ${SITE.author}`}
          >
            {email}
          </LinkButton>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
