---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";

interface PublicationLink {
  name: string;
  url: string;
}

interface PublicationItem {
  title: string;
  image?: string;
  authors?: string;
  venue: string;
  badge?: string;
  links: PublicationLink[];
}

interface PublicationGroup {
  year: string;
  items: PublicationItem[];
}

interface PublicationSection {
  id: string;
  title: string;
  description?: string;
  groups: PublicationGroup[];
}

const publicationSections: PublicationSection[] = [
  {
    id: "projects",
    title: "Projects",
    description: "开源项目",
    groups: [
      {
        year: "2026",
        items: [
          {
            title: "Native macOS menu bar app for CCF deadlines",
            image: "/assets/img/ccfddlmenubar.png",
            authors: "Kai Zhou",
            venue: "Open Source",
            badge: "ConfBar",
            links: [
              {
                name: "Github",
                url: "https://github.com/zkforge/CCFDDLMenuBar",
              },
            ],
          },
        ],
      },
    ],
  },
  {
    id: "papers",
    title: "Papers",
    description: "论文",
    groups: [
      {
        year: "2025",
        items: [
          {
            title: "Example",
            image: "/assets/img/papers_preview/bisenetv2.png",
            authors: "Kai Zhou",
            venue: "CVPR 2025",
            links: [
              { name: "arXiv", url: "http://arxiv.org" },
              { name: "Code", url: "https://github.com" },
              { name: "Springer", url: "https://link.springer.com/article" },
            ],
          },
        ],
      },
    ],
  },
];
---

<Layout title={`Publications | ${SITE.title}`}>
  <Header />

  <main id="main-content" class="mx-auto w-full max-w-app flex-1 px-4 py-8">
    <div class="space-y-16">
      {
        publicationSections.map(section => (
          <section
            id={section.id}
            class="mx-0 max-w-none space-y-8 px-0"
            aria-labelledby={`${section.id}-title`}
          >
            <div class="border-skin-line/70 border-b pb-4">
              <h2
                id={`${section.id}-title`}
                class="text-2xl font-bold text-accent sm:text-3xl"
              >
                {section.title}
              </h2>
              {section.description && (
                <p class="text-skin-base mt-2 text-sm leading-6 opacity-80 sm:text-base">
                  {section.description}
                </p>
              )}
            </div>

            <div class="space-y-12">
              {section.groups.map(group => (
                <div class="space-y-6">
                  <div class="bg-skin-fill/90 border-skin-line sticky top-0 z-10 border-b border-dashed py-2 backdrop-blur-sm">
                    <h3 class="text-xl font-bold text-accent">{group.year}</h3>
                  </div>

                  <ul class="space-y-10 pl-0">
                    {group.items.map(item => (
                      <li class="group flex flex-col items-start gap-6 sm:flex-row">
                        {item.image && (
                          <div class="border-skin-line/50 relative w-full shrink-0 overflow-hidden rounded-lg border shadow-sm sm:w-56 md:w-64">
                            <span class="absolute top-0 left-0 z-10 rounded-tl-lg rounded-br-lg bg-accent px-2 py-1 text-xs font-bold tracking-wider text-white">
                              {item.badge ?? item.venue.split(" ")[0]}
                            </span>

                            <img
                              src={item.image}
                              alt={item.title}
                              class="h-auto w-full object-cover transition-transform duration-500 group-hover:scale-105"
                              loading="lazy"
                            />
                          </div>
                        )}

                        <div class="flex flex-1 flex-col space-y-3 text-left">
                          <h4 class="text-skin-base text-left text-lg leading-snug font-bold transition-colors group-hover:text-accent sm:text-xl">
                            {item.title}
                          </h4>

                          {item.authors && (
                            <p class="text-skin-base text-sm leading-relaxed opacity-90">
                              {item.authors}
                            </p>
                          )}

                          <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
                            <span class="text-skin-accent bg-skin-accent/10 rounded px-2 py-0.5 font-semibold italic">
                              {item.venue}
                            </span>

                            <div class="flex gap-3">
                              {item.links.map(link => (
                                <LinkButton
                                  href={link.url}
                                  class="text-skin-base flex items-center gap-1 underline decoration-dashed underline-offset-4 opacity-70 transition-all hover:text-accent hover:opacity-100"
                                  title={link.name}
                                >
                                  <span>[{link.name}]</span>
                                </LinkButton>
                              ))}
                            </div>
                          </div>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>

  <Footer />
</Layout>
